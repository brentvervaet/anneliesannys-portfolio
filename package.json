		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.7.0",
		"@vue/tsconfig": "^0.9.1",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.2.1",
		"eslint-plugin-vue": "~10.8.0",
		"jiti": "^2.6.1",
		"npm-run-all2": "^8.0.4",
		"postcss": "^8.5.10",
		"prettier": "3.8.3",
		"tailwindcss": "^4.2.2",
